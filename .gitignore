# Secrets and local config — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
.uv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Node / Next.js
node_modules/
web/.next/
web/out/
web/.vercel/
*.tsbuildinfo
npm-debug.log*

# Data and models — regenerable, not source
data/
*.db
*.sqlite
models/
.cache/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
