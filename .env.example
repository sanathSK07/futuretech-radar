# Copy to .env and adjust. .env is git-ignored and must never be committed.

# PostgreSQL 16 with the pgvector extension.
# Matches infra/docker-compose.yml defaults for local development.
RADAR_DATABASE_URL=postgresql+psycopg://radar:radar@localhost:5433/radar

# Separate database used by the test suite (created by docker-compose init).
RADAR_TEST_DATABASE_URL=postgresql+psycopg://radar:radar@localhost:5433/radar_test

# local | ci | production
RADAR_ENVIRONMENT=local

# debug | info | warning | error
RADAR_LOG_LEVEL=info

# Contact address sent in the User-Agent of every outbound fetch, so source
# operators can reach us. Required before any ingestion runs (Sprint 0 Task 3).
RADAR_CRAWLER_CONTACT=sanath07@my.yorku.ca
